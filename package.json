{
  "name": "the-beer-name-generator",
  "version": "1.0.0",
  "description": "A web application that generates creative beer names and descriptions with Midjourney image generation capabilities",
  "main": "public/index.html",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "serve": "python3 -m http.server 8000 --directory public",
    "serve-alt": "npx serve public",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "expand-data": "node scripts/expandBeerData.js",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YoshKoz/TheBeerNameGenerator.git"
  },
  "keywords": [
    "beer",
    "generator",
    "names",
    "brewery",
    "craft-beer",
    "midjourney",
    "discord"
  ],
  "author": "Yoshi Tacke",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
